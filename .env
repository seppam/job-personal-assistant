# jpa-assistant Environment Variables
# Copy this file to .env.local and fill in your own keys.
# DO NOT commit .env.local to version control!

# ── AI Provider (choose at least one) ──────────────────────────────────────
# Google Gemini (recommended: free tier available at aistudio.google.com)
VITE_GEMMA_API_KEY=
VITE_GEMINI_API_KEY=

# Anthropic Claude (optional)
VITE_ANTHROPIC_API_KEY=

# ── Authentication ────────────────────────────────────────────────────────────
# Clerk publishable key (get from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=

# ── Database (optional — app works offline without this) ────────────────────
# MongoDB Atlas connection string
VITE_MONGODB_URI=

# MongoDB Atlas Data API (for cloud sync without a custom backend)
VITE_ATLAS_APP_ID=
VITE_ATLAS_API_KEY=
